--- !u!114 &1265013333
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1265013332}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d187653864693489116a4f74a4f058, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogue:
  - face: {fileID: 1718188644, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Short King Blorp
    delay: 0.07
    voiceLine: {fileID: 8300000, guid: 57106f03f3dff6848b160ec08a29caa3, type: 3}
    text: Drats! That earthquake really scattered my civillians.
  - face: {fileID: 1718188644, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Short King Blorp
    delay: 0.07
    voiceLine: {fileID: 8300000, guid: 21b4c867b4d0b3a4589a1ba3abfdc27c, type: 3}
    text: Fortunately, they have such a valiant, courageous, tall king, such as myself
  - face: {fileID: -213817462, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Jerry
    delay: 0.1
    voiceLine: {fileID: 8300000, guid: 62f3a2cf6ba3de641b763acde7608926, type: 3}
    text: But master your only 5 feet tall-
  - face: {fileID: 1718188644, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Short king blorp
    delay: 0.06
    voiceLine: {fileID: 8300000, guid: 9a3925208e8b4d243b3af508fb102465, type: 3}
    text: I'm average!!. But thats beside the point we need to get as many of those
      civillians into the escape pods as possible
  - face: {fileID: 1718188644, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Short king blorp
    delay: 0.06
    voiceLine: {fileID: 8300000, guid: 6fc61ab7e7c73ef4f87ef1e3a5125c6f, type: 3}
    text: I of course will have to use my brilliant merging powers. I dont know what
      on earth you'll do.
  - face: {fileID: -213817462, guid: cb2a32e012220804387b2277ce26bade, type: 3}
    cName: Jerry
    delay: 0.06
    voiceLine: {fileID: 8300000, guid: aae5301d535ffc34d91e80a27a66e2d0, type: 3}
    text: I wasn't planning on coming anyway to be honest.
  nextScene: 0
  alienParticles: {fileID: 0}
  isLevelDialogue: 0
  hasDialogue: 1
  face: {fileID: 1421031865}
  nameText: {fileID: 645387151}
  dialogueText: {fileID: 246620854}
  inDialogue: 0
  dialogueBox: {fileID: 0}
